/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

# pnpm store (local only)
.pnpm-store

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
