# ===== 服务配置 =====
PORT=3000
# 生产环境填 127.0.0.1（仅允许 Nginx 本机反代），本地开发可不填
HOST=0.0.0.0

# ===== DeepSeek 大模型 =====
DEEPSEEK_API_KEY=sk-在这里填入你的key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# ===== MySQL 数据库 =====
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=在这里填入数据库密码
DB_NAME=songxu

# ===== 对话记忆 =====
# 每次请求携带的最近历史消息条数
MEMORY_TURNS=10

# ===== 认证 =====
# JWT 签名密钥（必须更换为随机值，可用 node -e "console.log(require('crypto').randomBytes(32).toString('hex'))" 生成）
JWT_SECRET=在这里填入随机密钥
JWT_EXPIRES=7d

# ===== 高德地图 Web服务（IP定位 + 实时天气） =====
# 申请地址：https://console.amap.com/dev/key/app （服务平台选「Web服务」）
AMAP_KEY=在这里填入你的高德key
# IP 定位失败时的默认城市（adcode 6位编码，330100=杭州；北京市辖区110100，上海市辖区310100，广州市440100，成都市510100）
AMAP_DEFAULT_ADCODE=330100
AMAP_DEFAULT_CITY=杭州
